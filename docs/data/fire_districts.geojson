,"properties":{"boundary_id":"VTFD-0008","name":"Vergennes Panton Water District","towns":"Vergennes; Panton","county":"Addison","population":null,"pwsid":"VT0005010","pws_name":"VERGENNES PANTON WATER DISTRICT","area_sqkm":63.6323,"town_iou":1.0,"extent":"multi_town","status":"Active","original_data_provider":"VERSO / UVM","data_provider_type":"Academic","method":"GIS data","method_basis":"Municipal boundary","method_details":"District charter \u00a7 1 defines it as the area within the physical limits of the City of Vergennes and the Town of Panton, so the boundary is the union of their VCGI polygons. Assumes neither municipal boundary has moved since 1966.","source_document":"VCGI VT Data - Town Boundaries","source_url":"https://vergennespantonwatersdistrict.org/VPWD%20Charter.pdf","date_created":"2026-10-02","submitted_by":"VERSO / UVM (derived from district charter, not submitted)","submission_date":"2026-10-02","source_crs":"EPSG:32145","crs_inferred":"N","verification_status":"Not Verified","verification_date":"","verifier_name":"","district_type":"Water District","legal_authority_type":"Municipal vote/order","legal_citation":"Votes of the Town of Panton and the City of Vergennes under 24 V.S.A. \u00a7 3342; VPWD Charter \u00a7 1","legal_text":"The lawful voters of the Town of Panton and the City of Vergennes, respectively, having affirmatively voted pursuant to the provisions of 24 V.S.A. \u00a7 3342 to form a consolidated water district comprising the area within the physical limits of those municipalities, and the certification of those votes and of the conduct of the organizational meeting of the District held on August 11, 1966, having been submitted to the Secretary of State, there was created a consolidated water district known as \"Vergennes-Panton Water District\" on August 11, 1966.","recorded_document":"","district_website":"https://vergennespantonwatersdistrict.org/","clerk_name":"Betsy Sullivan; Kyle Rowe","clerk_email":"clerk@vergennes.org; clerk-treasurer@pantonvt.us","notes":"Authority defines the district as the whole of Vergennes and Panton. Union of the VCGI polygons for Vergennes and Panton, copied unmodified. The district website gives 1973 as a date; the charter says 1966."},"geometry":{"type":"Polygon","coordinates":[[[-73.25005,44.1532],[-73.25287,44.14877],[-73.25393,44.14822],[-73.25655,44.14749],[-73.2626,44.14516],[-73.26303,44.14425],[-73.26149,44.14137],[-73.26207,44.14045],[-73.26338,44.13971],[-73.2643,44.13895],[-73.26451,44.13799],[-73.26305,44.13633],[-73.26253,44.13545],[-73.2625,44.13445],[-73.26344,44.13263],[-73.2633,44.13163],[-73.26094,44.12808],[-73.25955,44.12635],[-73.25965,44.12543],[-73.26159,44.12378],[-73.26635,44.12246],[-73.27814,44.12112],[-73.32363,44.11669],[-73.35792,44.11352],[-73.37231,44.11196],[-73.41394,44.10784],[-73.41204,44.11065],[-73.41151,44.11195],[-73.41123,44.11377],[-73.41202,44.11963],[-73.41249,44.12127],[-73.41405,44.12408],[-73.41398,44.12693],[-73.41416,44.12816],[-73.41614,44.13236],[-73.41565,44.13346],[-73.41198,44.13778],[-73.41089,44.1385],[-73.40813,44.1399],[-73.40305,44.14498],[-73.40221,44.14694],[-73.40215,44.14806],[-73.40288,44.15048],[-73.4024,44.15154],[-73.40093,44.1527],[-73.27064,44.16526],[-73.2727,44.17699],[-73.24343,44.18026],[-73.2417,44.17244],[-73.23883,44.1566],[-73.23939,44.15522],[-73.24998,44.15443],[-73.25005,44.1532]]]}},{"type":"Feature","properties":{"boundary_id":"VTFD-0005","name":"Williamstown Fire District","towns":"Williamstown","county":"Orange","population":null,"pwsid":"","pws_name":"","area_sqkm":104.5307,"town_iou":1.0,"extent":"coextensive_with_town","status":"Active","original_data_provider":"VERSO / UVM","data_provider_type":"Academic","method":"GIS data","method_basis":"Statute","method_details":"Statute defines the corporate limits as the Town of Williamstown's boundary lines, so the VCGI town polygon IS the district boundary. Copied unmodified.","source_document":"VCGI VT Data - Town Boundaries","source_url":"https://legislature.vermont.gov/statutes/section/24APPENDIX/505/00002","date_created":"2026-08-14","submitted_by":"VERSO / UVM (derived from statute, not submitted)","submission_date":"2026-08-14","source_crs":"EPSG:32145","crs_inferred":"N","verification_status":"Not Verified","verification_date":"","verifier_name":"","district_type":"Fire District","legal_authority_type":"Legislative charter","legal_citation":"24 V.S.A. App. ch. 505, \u00a7 2 (Williamstown Fire District Charter)","legal_text":"(a) The legal voters of the District shall be a body corporate. The corporate limits shall be the boundary lines of the Town of Williamstown, being bounded as follows: easterly by the line of Washington; southerly by the lines of Chelsea and Brookfield; westerly by the lines of Northfield and Berlin; and northerly by the lines of Berlin and Barre.","recorded_document":"","district_website":"","clerk_name":"Barbara Graham","clerk_email":"clerk@williamstownvt.org","notes":"Statute defines the district's corporate limits as the Town of Williamstown's boundary lines. VCGI town polygon copied unmodified per statute. Not yet verified that the charter boundary is unchanged by any later amendment or annexation. Not in the VRWA 80-district roster: that roster lists water-providing districts, and this district has no public water system in SDWIS."},"geometry":{"type":"Polygon","coordinates":[[[-72.53198,44.155],[-72.49254,44.14378],[-72.47875,44.14007],[-72.45554,44.13334],[-72.46316,44.12031],[-72.47581,44.09804],[-72.49393,44.06584],[-72.50242,44.05036],[-72.53821,44.06248],[-72.58573,44.07586],[-72.62911,44.08783],[-72.61156,44.11741],[-72.58656,44.16026],[-72.57067,44.15629],[-72.56398,44.15478],[-72.55971,44.16291],[-72.55456,44.16133],[-72.53198,44.155]]]}}]}